            "@type": "WorkflowStep",
            "name": "return",
            "description": null,
            "arguments": {
                "output": "{%- set sdwan_members = vars.sdwan_members -%}\n{%- set sdwan_health = vars.sdwan_health -%}\n{%- set health_checks = sdwan_health.keys()|list -%}\n\n{%- set table = [] -%}\n{%- for m in sdwan_members -%}\n  {%- set name = m.interface -%}\n  {%- set d = {} -%}\n  {%- set h = {} -%}\n\n  {%- for hc in health_checks -%}\n    {%- if name in sdwan_health[hc] -%}\n      {%- set href = sdwan_health[hc][name] -%}\n      {%- set hd = {\n        \"status\":href.status,\n        \"latency\":\"{:.2f}\".format(href.latency | float),\n        \"jitter\":\"{:.2f}\".format(href.jitter | float),\n        \"loss\":href.packet_loss,\n        \"state_changed_epoch\":href.state_changed,\n        \"state_changed\":arrow.get(href.state_changed)\n            .to(\"UTC\")\n            .format(\"YYYY-MM-DD HH:mm:ss ZZ\")\n      } -%}\n      {%- do h.update({hc:hd}) -%}\n    {%- endif -%}\n  {%- endfor -%}\n\n{%- do d.update({\n  \"name\": name,\n  \"link\": m.link,\n  \"sessions\":m.session,\n  \"state_changed_epoch\":m.state_changed,\n  \"state_changed\":arrow.get(m.state_changed)\n     .to(\"UTC\")\n     .format(\"YYYY-MM-DD HH:mm:ss ZZ\"),\n  \"health_checks\":h\n}) -%}\n  {%- do table.append(d) -%}\n{%- endfor -%}\n\n{{table}}"
            },
